# Copy to .env.connected (connected build) — never commit real values.
# Demo builds (npm run build:demo) must NOT set VITE_API_BASE_URL.
VITE_API_BASE_URL=https://api.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: base path when hosted under a sub-folder (GitHub Pages project site)
VITE_BASE_PATH=/
